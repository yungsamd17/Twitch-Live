{
    "manifest_version": 3,
    "name": "Sam's Twitch Live",
    "description": "Your ultimate companion for staying connected with your favorite Twitch streams.",
    "version": "1.3.4",
    "author": "Sam @yungsamd17",
    "homepage_url": "https://github.com/yungsamd17/Twitch-Live",
    "icons":
    {
        "16": "src/icons/icon-16.png",
        "48": "src/icons/icon-48.png",
        "128": "src/icons/icon-128.png"
    },
    "permissions": [
        "alarms",
        "storage",
        "identity",
        "clipboardWrite"
    ],
    "host_permissions": [
        "https://api.twitch.tv/*",
        "https://id.twitch.tv/*"
    ],
    "content_scripts": [
        {
            "matches": ["https://player.twitch.tv/*"],
            "js": ["src/js/content/player-title.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.twitch.tv/*", "https://player.twitch.tv/*", "https://embed.twitch.tv/*"],
            "js": ["src/js/content/channel-copy.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.twitch.tv/*", "https://player.twitch.tv/*", "https://embed.twitch.tv/*"],
            "js": ["src/js/content/chat-popout.js"],
            "run_at": "document_idle"
        }
    ],
    "background":
    {
        "service_worker": "src/js/background.js"
    },
    "action":
    {
        "default_title": "Sam's Twitch Live",
        "default_popup": "popup.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'none'"
    }
}